{
  "manifest_version": "2.0",
  "name": "Firefox",
  "description": "Fast, private and safe web browser.",
  "version": "153.0.3",
  "image": "ghcr.io/containerpak/firefox:main",
  "binaries": ["/usr/bin/firefox"],
  "desktop_entries": ["/usr/share/applications/org.mozilla.firefox.desktop"],
  "dependencies": [],
  "addons": [],
  "idle_time": 0,
  "override": {
    "socketX11": true,
    "socketWayland": true,
    "socketPulseAudio": true,
    "socketSessionBus": true,
    "socketSystemBus": false,
    "socketSshAgent": false,
    "socketCups": true,
    "socketGpgAgent": false,
    "socketAtSpiBus": true,
    "socketBluetooth": false,
    "deviceDri": true,
    "deviceKvm": false,
    "deviceShm": true,
    "deviceAlsa": false,
    "deviceVideo": false,
    "deviceFuse": false,
    "deviceTun": false,
    "deviceUsb": false,
    "deviceAll": false,
    "notification": true,
    "filesystem": [
      {"path": "home", "access": "read-write"}
    ],
    "env": [],
    "network": true,
    "process": false,
    "asRoot": false,
    "allowedHostCommands": ["xdg-open"]
  }
}
