{
  "$schema": "https://raw.githubusercontent.com/Containerpak/cpak/v2/schema/manifest-v3.json",
  "manifest_version": "3.0",
  "name": "Firefox",
  "description": "Fast, private and safe web browser.",
  "version": "155.0",
  "image": "ghcr.io/containerpak/firefox@sha256:856fa2098082a3258576829a6b7021679976de9bc045cf673ddeaaa7567cb9de",
  "binaries": [
    "/usr/bin/firefox"
  ],
  "desktop_entries": [
    "/usr/share/applications/org.mozilla.firefox.desktop"
  ],
  "dependencies": [],
  "addons": [],
  "idle_time": 0,
  "override": {
    "displayX11": true,
    "clipboard": {
      "hostToApp": true,
      "appToHost": true
    },
    "socketWayland": true,
    "socketPulseAudio": true,
    "socketSshAgent": false,
    "socketCups": true,
    "socketGpgAgent": false,
    "bluetooth": true,
    "deviceDri": true,
    "deviceKvm": false,
    "deviceShm": true,
    "deviceAlsa": false,
    "deviceVideo": false,
    "deviceFuse": false,
    "deviceTun": false,
    "deviceUsb": false,
    "deviceSerial": false,
    "deviceInput": false,
    "deviceTTY": false,
    "deviceAll": false,
    "notification": true,
    "openURI": false,
    "hostApplications": false,
    "filesystem": [
      {
        "path": "home",
        "access": "read-write"
      }
    ],
    "env": [],
    "network": true,
    "hostNetwork": true,
    "process": false,
    "userNamespaces": true,
    "memoryMaxMB": 0,
    "cpuQuota": 0,
    "pidsMax": 0,
    "asRoot": false
  }
}
